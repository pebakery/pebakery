<!DOCTYPE html>
<html>
    <!-- Header Template -->
    {{ include '_LogLayoutHeader.sbnhtml' }}

    <!-- Body -->
    <body id="page-top" data-bs-spy="scroll" data-bs-target="#pbNav" data-bs-root-margin="-70px 0px -40%" tabindex="0">
        <!-- Sticky Jump Nav -->
        <nav id="pbNav" class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" href="#page-top">PEBakery Build Log</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#pbNavContent" aria-controls="pbNavContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="pbNavContent">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="#summary">Summary</a></li>
                        {{ if BuildHostWindowsVersion && BuildHostDotnetVersion }}
                        <li class="nav-item"><a class="nav-link" href="#hostenv">Host Env</a></li>
                        {{ end }}
                        <li class="nav-item"><a class="nav-link" href="#statistics">Statistics</a></li>
                        {{ if 0 < ErrorSummaries.size }}
                        <li class="nav-item"><a class="nav-link" href="#error_summary">Errors</a></li>
                        {{ end }}
                        {{ if 0 < WarnSummaries.size }}
                        <li class="nav-item"><a class="nav-link" href="#warn_summary">Warnings</a></li>
                        {{ end }}
                        <li class="nav-item"><a class="nav-link" href="#script">Scripts</a></li>
                        <li class="nav-item"><a class="nav-link" href="#ref-script">Ref Scripts</a></li>
                        <li class="nav-item"><a class="nav-link" href="#vars">Variables</a></li>
                        <li class="nav-item"><a class="nav-link" href="#codelogs">Code Logs</a></li>
                    </ul>
                    <button type="button" class="btn btn-outline-light btn-sm pb-theme-toggle" title="Toggle dark mode">
                        <i class="pb-theme-icon fas fa-fw fa-moon"></i>
                    </button>
                </div>
            </div>
        </nav>

        <h1 class="container mt-2 text-center">{{ HeadTitle | html.escape }}</h1>

        <!-- Summary -->
        <header id="summary" class="container-fluid">
            <h2 class="mt-2">Summary</h2>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-content table-nonfluid">
                    <tbody>
                        <tr>
                            <th class="table-dark">Built by</th>
                            <td>PEBakery {{ BuiltEngineVersion | html.escape }}</td>
                        </tr>
                        <tr>
                            <th class="table-dark">Exported by</th>
                            <td>PEBakery {{ ExportEngineVersion | html.escape }}</td>
                        </tr>
                        <tr>
                            <th class="table-dark">Started at</th>
                            <td>{{ BuildStartTimeStr | html.escape }}</td>
                        </tr>
                        <tr>
                            {{ if BuildIsFinished }}
                            <th class="table-dark">Finished at</th>
                            {{ else }}
                            <th class="table-dark">Exported at</th>
                            {{ end }}
                            <td>{{ BuildEndTimeStr | html.escape }}</td>
                        </tr>
                        <tr>
                            <th class="table-dark">Elapsed</th>
                            <td>{{ BuildTookTimeStr | html.escape }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </header>

        <!-- Host Environment -->
        {{ if BuildHostWindowsVersion && BuildHostDotnetVersion }}
        <section id="hostenv" class="container-fluid">
            <h2 class="mt-2">Host Environment</h2>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-content table-nonfluid">
                    <tbody>
                        <tr>
                            <th class="table-dark">Windows</th>
                            <td>{{ BuildHostWindowsVersion | html.escape }}</td>
                        </tr>
                        <tr>
                            <th class="table-dark">.NET Runtime</th>
                            <td>{{ BuildHostDotnetVersion | html.escape }}</td>
                        </tr>
                        {{ if BuildHostLanguage }}
                        <tr>
                            <th class="table-dark">Language</th>
                            <td>{{ BuildHostLanguage | html.escape }}</td>
                        </tr>
                        {{ end }}
                        {{ if BuildHostAnsiEncoding }}
                        <tr>
                            <th class="table-dark">ANSI Encoding</th>
                            <td>{{ BuildHostAnsiEncoding | html.escape }}</td>
                        </tr>
                        {{ end }}
                        {{ if BuildHostOemEncoding }}
                        <tr>
                            <th class="table-dark">OEM Encoding</th>
                            <td>{{ BuildHostOemEncoding | html.escape }}</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>
        </section>
        {{ end }}

        <!-- Statistics -->
        <section id="statistics" class="container-fluid mt-2">
            <h2 class="mt-2">Log Statistics</h2>
            <table class="table table-striped table-bordered pb-table-content table-nonfluid">
                <thead class="table-dark text-center">
                    <tr>
                        <th class="text-nowrap">LogState</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    {{ for $item in LogStats }}
                    <tr>
                        <th class="text-nowrap"><span class="{{ $item.State | LogStateCssFaClass }}">{{ $item.State | LogStateFaIcon }}</span>&nbsp;{{ LogStateStr false $item.State | html.escape }}</th>
                        <td class="text-center">{{ $item.Count | html.escape }}</td>
                    </tr>
                    {{ end }}
                </tbody>
            </table>
        </section>

        <!-- Error Summary, Warning Summary -->
        {{ func RenderErrorWarnSummary }}
            {{ 
                # 0 = error, 1 = warning
                $type = $0
                # ErrorCodes or WarnCodes
                $model = $1

                if $type == 0
                    $h2 = "Errors"
                    $sectionMsg = "error"
                    $sectionId = "error_summary"
                    $hrefPrefix = "#error_"
                    $tdClass = "bg-danger"
                else
                    $h2 = "Warnings"
                    $sectionMsg = "warning"
                    $sectionId = "warn_summary"
                    $hrefPrefix = "#warn_"
                    $tdClass = "bg-warning"
                end

                if 1 < $model.size
                    $sectionMsg = string.append $sectionMsg "s"
                end
            }}

            {{ if 0 < $model.size }}
            <section id="{{ $sectionId }}" class="container-fluid mt-2">
                <h2 class="mt-2">{{ $h2 }}</h2>
                {{ for $d in $model }}
                <span class="font-monospace">{{ $d.Codes.size }} {{ $sectionMsg }} in script &#91;{{ $d.ScriptName | html.escape }}&#93; &#40;{{ $d.ScriptPath | html.escape }}&#41;</span>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered pb-table-codes table-nonfluid">
                        <thead class="table-dark text-center">
                            <tr>
                                <th class="text-nowrap">State</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ for $item in $d.Codes }}
                            <tr>
                                <td class="text-nowrap {{ $tdClass }}">
                                    <a class="text-dark" href='{{ $hrefPrefix }}{{ $item.Href }}'>
                                        {{ $item.State | LogStateFaIcon }}{{ LogStateStr true $item.State | html.escape }}
                                    </a>
                                </td>
                                {{ if $item.RefScriptMsg != null }}
                                    <td class="pb-whitespace">{{ $item.Message | html.escape }}<br>{{ $item.RefScriptMsg | html.escape }}</td>
                                {{ else }}
                                    <td class="pb-whitespace">{{ $item.Message | html.escape }}</td>
                                {{ end }}
                            </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </div>
                {{ end }}
            </section>
            {{ end }}
        {{ end }}

        {{ RenderErrorWarnSummary 0 ErrorSummaries }}
        {{ RenderErrorWarnSummary 1 WarnSummaries }}

        <!-- Scripts -->
        <section id="script" class="container-fluid mt-2">
            <h2>Scripts</h2>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-content text-center table-nonfluid">
                    <thead class="table-dark">
                        <tr>
                            <th>Index</th>
                            <th>Script</th>
                            <th>Version</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ for $item in Scripts }}
                        <tr class="py-1">
                            <td>{{ $item.IndexStr | html.escape }}</td>
                            <td class="text-start" data-bs-toggle="tooltip" title='{{ $item.Path | html.escape }}'><a href="#script-{{ $item.IndexStr | html.escape }}">{{ $item.Name | html.escape }}</a></td>
                            <td>{{ $item.Version | html.escape }}</td>
                            <td class="text-end">{{ $item.TimeStr | html.escape }}</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Referenced Script -->
        <section id="ref-script" class="container-fluid mt-2">
            <h2>Referenced Scripts</h2>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-content text-center table-nonfluid">
                    <thead class="table-dark">
                        <tr>
                            <th>Index</th>
                            <th>Script</th>
                            <th>Version</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ for $item in RefScripts }}
                        <tr>
                            <td>{{ $item.IndexStr | html.escape }}</td>
                            <td class="text-start" data-bs-toggle="tooltip" title='{{ $item.Path | html.escape }}'>{{ $item.Name | html.escape }}</td>
                            <td>{{ $item.Version | html.escape }}</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Variables -->
        <section id="vars" class="container-fluid mt-2">
            <h2>Variables</h2>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-codes table-nonfluid">
                    <thead class="table-dark text-center">
                        <tr>
                            <th class="text-nowrap">Type</th>
                            <th>Key</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ for $item in Variables }}
                        <tr>
                            {{ if $item.TypeStr == "Fixed" }}
                            <td class="text-nowrap text-primary">
                                <i class="fas fa-fw fa-lock"></i>{{ $item.TypeStr }}
                            </td>
                            {{ else if $item.TypeStr == "Global" }}
                            <td class="text-nowrap text-success">
                                <i class="fas fa-fw fa-globe"></i>{{ $item.TypeStr }}
                            </td>
                            {{ end }}
                            <td>{{ $item.Key }}</td>
                            <td>{{ $item.Value }}</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Code Logs -->
        {{ func RenderLogFlags }}
            {{
                # $item = entry of $entry.Codes (One CodeLogItem)
                $item = $0
            }}
            {{ if ShowLogFlags }}
                {{ if $item.RefScriptTitle }}
                    <td class="text-nowrap text-primary" data-bs-toggle="tooltip" title='{{ $item.RefScriptTitle | html.escape }} '>{{ $item.FlagsStr | html.escape }}</td>
                {{ else }}
                    <td class="text-nowrap">{{ $item.FlagsStr | html.escape }}</td>
                {{ end }}
            {{ end }}
        {{ end }}

        <h2 id="codelogs" class="container-fluid mt-2">Code Logs</h2>
        {{ for $entry in CodeLogs }}
        <div id="script-{{ $entry.Script.IndexStr }}" class="container-fluid mt-2">
            <h3><span class="badge bg-secondary font-monospace">{{ $entry.Script.IndexStr | html.escape }}/{{ CodeLogs.size }}</span> {{ $entry.Script.Name | html.escape }}</h3>
            <div class="text-muted font-monospace mb-2">{{ $entry.Script.Path | html.escape }}</div>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-codes table-nonfluid">
                    <thead class="table-dark text-center">
                        <tr>
                            <th class="text-nowrap">State</th>
                            {{ if ShowLogFlags }}
                            <th class="text-nowrap">Flags</th>
                            {{ end }}
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ for $item in $entry.Codes }}
                        <tr class='{{ $item.State | LogStateCssTrClass }}' {{ BuildErrorWarnRefId $item.Href $item.State }}>
                            <td class='text-nowrap {{ $item.State | LogStateCssTdClass }}'>{{ $item.State | LogStateFaIcon }}{{ LogStateStr true $item.State | html.escape }}</td>
                            {{ RenderLogFlags $item }}
                            <td class="pb-whitespace">{{ $item.Message | html.escape }}</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>

            {{ if 0 < $entry.Variables.size }}
            <span class="font-monospace">Local Variables of Script &#91;{{ $entry.Script.Name | html.escape }}&#93;</span>
            <div class="table-responsive">
                <table class="table table-striped table-bordered pb-table-codes table-nonfluid">
                    <thead class="table-dark text-center">
                        <tr>
                            <th class="text-nowrap">Type</th>
                            <th>Key</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ for $item in $entry.Variables }}
                        <tr>
                            <td class="text-nowrap text-localvar"><i class="fas fa-fw fa-cube"></i>Local</td>
                            <td>{{ $item.Key | html.escape }}</td>
                            <td>{{ $item.Value | html.escape }}</td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>
            {{ end }}
        </div>
        {{ end }}

        <!-- Footer Template -->
        {{ include '_LogLayoutFooter.sbnhtml' }}
    </body>
</html>

